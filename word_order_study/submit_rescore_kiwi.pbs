#!/bin/bash
# Word-order study: re-score finished predictions with COMET-KIWI (reference-free).
#
# Reads the prediction.json files already produced by the eval jobs, so nothing is re-decoded and this
# is quick. Answers whether the degradation pattern is a property of the models or of the references.
#
# Unpinned per the GPU policy. COMET-KIWI is a gated repo, so ~/.hf_token must be able to read it
# (accept the licence once at https://huggingface.co/Unbabel/wmt22-cometkiwi-da).
#
#   qsub -l walltime=2:00:00 -l select=1:ncpus=8:mem=48gb:ngpus=1 word_order_study/submit_rescore_kiwi.pbs
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -N wo-kiwi

cd "$PBS_O_WORKDIR"
set -e

if [ ! -f east_scripts/env.sh ] && [ -f ../east_scripts/env.sh ]; then cd ..; fi
[ -f east_scripts/env.sh ] || { echo "ERROR: submit from the EAST repo root. PWD=$(pwd)" >&2; exit 1; }
echo "Working dir: $(pwd)"

module load python/3.11.3
python3 -m venv "$TMPDIR/east-venv"
source "$TMPDIR/east-venv/bin/activate"
source east_scripts/env.sh
bash east_scripts/setup_katana_env.sh

if [ -z "${HF_TOKEN:-}" ] && [ -f "$HOME/.hf_token" ]; then
    HF_TOKEN=$(cat "$HOME/.hf_token"); export HF_TOKEN
fi
: "${HF_TOKEN:?COMET-KIWI is gated, set HF_TOKEN via ~/.hf_token}"

export EAST_CACHE="${EAST_CACHE:-$TMPDIR/east_cache}"
mkdir -p "$EAST_CACHE/huggingface"
export HF_HOME="$EAST_CACHE/huggingface"
export HF_HUB_CACHE="$EAST_CACHE/huggingface/hub"

echo "=== nvidia-smi ==="
nvidia-smi || echo "WARNING: no GPU visible"

echo "=== COMET-KIWI re-scoring over results/wordorder ==="
time python word_order_study/rescore_kiwi.py --result_root results/wordorder --write

echo "DONE. kiwi scores written into each results.json"
