#!/bin/bash
# Word-order study, Step 5: evaluate one trained system on the held-out test set.
#
# Loads the frozen EAST-8B base plus that system's LoRA adapter from Hugging Face, runs simultaneous
# decoding at one latency setting, and scores quality (chrF++, spBLEU, BLEU) and latency (AL in words).
# COMET is deliberately skipped: the Alexandria authors report it is unreliable for Arabic dialects,
# so the same metrics are used for all five languages to keep the comparison fair.
#
# Set LANGUAGE, METHOD and LATENCY. Results go under results/wordorder/<lang>-<method>/<latency>/.
#
# GPU note: Katana turns the requested RAM into a minimum GPU memory (mem=64gb becomes
# mem_per_gpu_gte_93), which leaves only H200. mem=32gb becomes gte_45, which L40S and H200 satisfy.
# An 8B model in bfloat16 needs about 16 GB, so 32gb of RAM is enough and gives a bigger GPU pool.
#
#   Smoke (20 sentences, one latency):
#   qsub -l walltime=2:00:00 -l select=1:ncpus=8:mem=32gb:ngpus=1:gpu_model=L40S -v LANGUAGE=korean,METHOD=generic,LATENCY=medium,MAX_EXAMPLES=20 word_order_study/submit_eval.pbs
#   Full, one cell:
#   qsub -l walltime=2:00:00 -l select=1:ncpus=8:mem=32gb:ngpus=1:gpu_model=L40S -v LANGUAGE=korean,METHOD=generic,LATENCY=medium word_order_study/submit_eval.pbs
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1:gpu_model=L40S
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -N wo-eval

cd "$PBS_O_WORKDIR"
set -e

if [ ! -f east_scripts/env.sh ] && [ -f ../east_scripts/env.sh ]; then cd ..; fi
[ -f east_scripts/env.sh ] || { echo "ERROR: submit from the EAST repo root. PWD=$(pwd)" >&2; exit 1; }
echo "Working dir: $(pwd)"

module load python/3.11.3
python3 -m venv "$TMPDIR/east-venv"
source "$TMPDIR/east-venv/bin/activate"
source east_scripts/env.sh
bash east_scripts/setup_katana_env.sh

if [ -z "${HF_TOKEN:-}" ] && [ -f "$HOME/.hf_token" ]; then
    HF_TOKEN=$(cat "$HOME/.hf_token"); export HF_TOKEN
fi
: "${HF_TOKEN:?Set HF_TOKEN via ~/.hf_token, the adapters are in a private repo}"
: "${LANGUAGE:?Set LANGUAGE=vietnamese|msa|korean|saudi|egyptian via qsub -v}"
: "${METHOD:?Set METHOD=generic|specific via qsub -v}"
: "${LATENCY:?Set LATENCY=low|low-medium|medium|medium-high|high via qsub -v}"
MAX_EXAMPLES=${MAX_EXAMPLES:-}

export EAST_CACHE="${EAST_CACHE:-$TMPDIR/east_cache}"
mkdir -p "$EAST_CACHE/huggingface"
export HF_HOME="$EAST_CACHE/huggingface"
export HF_HUB_CACHE="$EAST_CACHE/huggingface/hub"

case "$LANGUAGE" in
    vietnamese) LC=vi;; msa) LC=msa;; korean) LC=ko;; saudi) LC=sa;; egyptian) LC=eg;;
    *) echo "unknown LANGUAGE=$LANGUAGE" >&2; exit 1;;
esac

BASE_MODEL="biaofu-xmu/EAST-8B"
ADAPTER="Henry236/east8b-${LC}-lora-${METHOD}"
TEST_FILE="word_order_study/data/${LANGUAGE}/test.eval.json"
[ -f "$TEST_FILE" ] || { echo "ERROR: ${TEST_FILE} not found, run prepare_test_data.py first" >&2; exit 1; }

SUFFIX=""
MAX_ARGS=""
if [ -n "$MAX_EXAMPLES" ]; then
    SUFFIX="-smoke"
    MAX_ARGS="--max_examples ${MAX_EXAMPLES}"
fi
OUT_DIR="results/wordorder/${LANGUAGE}-${METHOD}${SUFFIX}/${LATENCY}"

echo "=== nvidia-smi ==="
nvidia-smi || echo "WARNING: no GPU visible"

echo "=== Step 5 eval: ${LANGUAGE}/${METHOD} latency=${LATENCY} -> ${OUT_DIR} ==="
time python ./east_scripts/eval/simuleval_standalone.py \
    --model_path "${BASE_MODEL}" \
    --adapter_path "${ADAPTER}" \
    --eot_token "<|eot_id|>" \
    --data_path "${TEST_FILE}" \
    --output_dir "${OUT_DIR}" \
    --latency "${LATENCY}" \
    --max_new_tokens 256 \
    --num_beams 5 \
    ${MAX_ARGS}

echo "DONE. ${OUT_DIR}"
